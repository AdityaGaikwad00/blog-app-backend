# Copy this file to .env and fill in your own values. Never upload .env to GitHub.
PORT=5000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_text
# Local MongoDB:  mongodb://127.0.0.1:27017/inkwell
# MongoDB Atlas:  mongodb+srv://<username>:<password>@<cluster-address>/inkwell?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/inkwell
